<?xml version="1.0" encoding="utf-8"?>
<!-- The page under coming back as the one over it goes (Motion.pop). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="400" android:interpolator="@interpolator/emphasized" android:zAdjustment="bottom">
    <translate android:fromXDelta="-50%" android:toXDelta="0" />
    <scale android:fromXScale="0.7" android:toXScale="1" android:fromYScale="0.7" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:fromAlpha="0" android:toAlpha="1" />
</set>
