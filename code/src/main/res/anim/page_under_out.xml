<?xml version="1.0" encoding="utf-8"?>
<!-- The page under one coming in: half a width left, down to 0.7 and out (Motion.push). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="400" android:interpolator="@interpolator/emphasized" android:zAdjustment="bottom">
    <translate android:fromXDelta="0" android:toXDelta="-50%" />
    <scale android:fromXScale="1" android:toXScale="0.7" android:fromYScale="1" android:toYScale="0.7"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:fromAlpha="1" android:toAlpha="0" />
</set>
